{
  "manifest_version": 3,
  "name": "Busted: Website Blocker & Focus Mode",
  "version": "1.4.0",
  "description": "Website blocker and screen time tracker. Block sites on a schedule or with daily limits, block YouTube Shorts. Free, private.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs",
    "favicon",
    "idle"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Busted",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
