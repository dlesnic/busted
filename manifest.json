{
  "manifest_version": 3,
  "name": "Busted: Website Blocker & Focus Mode",
  "version": "1.3.1",
  "description": "Block distracting websites, set daily limits, run focus sessions. Slip up and a grumpy owl catches you. Nothing leaves your device.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Busted",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
