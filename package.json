{
  "name": "busted",
  "version": "1.4.0",
  "private": true,
  "description": "Website blocker for Chrome: block sites always, on a schedule or after a daily limit, and run focus sessions.",
  "license": "MIT",
  "repository": "github:dlesnic/busted",
  "homepage": "https://gotbusted.app",
  "scripts": {
    "test": "node --experimental-default-type=module tests/unit.mjs && node tests/e2e.mjs extension",
    "test:unit": "node --experimental-default-type=module tests/unit.mjs",
    "test:e2e": "node tests/e2e.mjs extension",
    "build": "sh tools/package.sh"
  },
  "devDependencies": {
    "playwright-core": "1.58.2"
  }
}
