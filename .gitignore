# Only the extension source, tests, tools and docs are public. Everything else stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/manifest.json
!/background.js
!/shared.js
!/presets.js
!/popup.html
!/popup.css
!/popup.js
!/blocked.html
!/blocked.css
!/blocked.js
!/art/
!/icons/
!/tests/
!/tools/
!/docs/
!/.github/
!/package.json
!/package-lock.json
!/CHANGELOG.md
/tools/build_guides.py
.DS_Store
node_modules/
